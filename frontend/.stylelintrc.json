{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "stylelint-scss"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "import",
          "tailwind",
          "apply",
          "layer",
          "responsive",
          "screen",
          "theme",
          "function",
          "if",
          "each",
          "include",
          "mixin"
        ]
      }
    ],
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "import",
          "tailwind",
          "apply",
          "layer",
          "responsive",
          "screen",
          "theme",
          "function",
          "if",
          "each",
          "include",
          "mixin"
        ]
      }
    ]
  }
}