# Database
DATABASE_URL="postgresql://user:password@localhost:5434/crm_db?schema=public"

# JWT
# Secret key for signing JWT tokens (REQUIRED - change in production!)
# Use a strong random string (minimum 32 characters recommended)
JWT_SECRET="your-secret-key-change-in-production"
# Token expiration time (default: "7d")
# Accepts formats: "7d" (days), "12h" (hours), "1h" (hours), "30m" (minutes)
JWT_EXPIRES_IN="7d"

# Password Hashing (bcrypt)
# Optional: Override salt rounds for bcrypt (default: 12)
# Lower values (e.g., 8-10) for faster development, higher (12-14) for production
# BCRYPT_SALT_ROUNDS=12

# Environment
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Tenant Identifier (subdomain, header, or path)
TENANT_IDENTIFIER_TYPE="subdomain"

# Email (for password recovery)
# V1: Email opcional - console.log em DEV, implementar SMTP na V2
# EMAIL_HOST="smtp.example.com"      # Host SMTP (ex: smtp.gmail.com)
# EMAIL_PORT=587                     # Porta SMTP (587 para TLS, 465 para SSL)
# EMAIL_USER="noreply@example.com"   # Usuário SMTP
# EMAIL_PASS="password"              # Senha SMTP
