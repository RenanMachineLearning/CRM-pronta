# Database
DATABASE_URL="postgresql://user:password@localhost:5434/crm_db?schema=public"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Password Hashing (bcrypt)
# Optional: Override salt rounds for bcrypt (default: 12)
# Lower values (e.g., 8-10) for faster development, higher (12-14) for production
# BCRYPT_SALT_ROUNDS=12

# Environment
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Tenant Identifier (subdomain, header, or path)
TENANT_IDENTIFIER_TYPE="subdomain"

# Email (for password recovery - to be configured)
# EMAIL_HOST="smtp.example.com"
# EMAIL_PORT=587
# EMAIL_USER="noreply@example.com"
# EMAIL_PASS="password"
