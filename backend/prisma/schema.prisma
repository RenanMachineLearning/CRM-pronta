generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  subdomain           String?              @unique
  status              TenantStatus         @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  addresses           Address[]
  auditLogs           AuditLog[]
  businessRules       BusinessRule[]
  companies           Company[]
  contactEmails       ContactEmail[]
  contactPhones       ContactPhone[]
  contacts            Contact[]
  entities            Entity[]
  entityData          EntityData[]
  entityRelationData  EntityRelationData[]
  fields              Field[]
  importJobs          ImportJob[]
  leads               Lead[]
  notes               Note[]
  opportunities       Opportunity[]
  passwordResetTokens PasswordResetToken[]
  permissions         Permission[]
  pipelineStages      PipelineStage[]
  pipelines           Pipeline[]
  relationships       Relationship[]
  roles               Role[]
  tags                Tag[]
  tasks               Task[]
  users               User[]

  @@map("tenants")
}

model User {
  id                  String               @id @default(uuid())
  email               String
  passwordHash        String               @map("password_hash")
  name                String
  tenantId            String
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  auditLogs           AuditLog[]
  importJobs          ImportJob[]
  notesCreated        Note[]
  passwordResetTokens PasswordResetToken[]
  tasksAssigned       Task[]               @relation("TaskAssignedTo")
  tasksCreated        Task[]               @relation("TaskCreatedBy")
  userRoles           UserRole[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, id])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  tenantId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@map("password_reset_tokens")
}

model Role {
  id              String           @id @default(uuid())
  name            String
  tenantId        String
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  entity          String
  action          String
  field           String?
  tenantId        String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([tenantId, entity, action, field])
  @@index([tenantId, entity, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@unique([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  userId     String
  tenantId   String
  changes    Json?
  timestamp  DateTime @default(now()) @map("timestamp")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, id])
  @@map("audit_logs")
}

model Entity {
  id                  String         @id @default(uuid())
  name                String
  label               String
  tenantId            String
  isSystem            Boolean        @default(false)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityData          EntityData[]
  fields              Field[]
  sourceRelationships Relationship[] @relation("SourceEntity")
  targetRelationships Relationship[] @relation("TargetEntity")

  @@unique([tenantId, name])
  @@index([tenantId, id])
  @@map("entities")
}

model Field {
  id           String   @id @default(uuid())
  entityId     String
  name         String
  label        String
  type         String
  required     Boolean  @default(false)
  unique       Boolean  @default(false)
  defaultValue Json?
  options      Json?
  tenantId     String
  order        Int      @default(0)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([entityId, name])
  @@index([tenantId, entityId])
  @@index([tenantId, id])
  @@map("fields")
}

model Relationship {
  id             String               @id @default(uuid())
  sourceEntityId String
  targetEntityId String
  type           String
  name           String
  tenantId       String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  relationData   EntityRelationData[]
  sourceEntity   Entity               @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity   Entity               @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@map("relationships")
}

model EntityRelationData {
  id             String       @id @default(uuid())
  tenantId       String
  relationshipId String
  sourceRecordId String
  targetRecordId String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, relationshipId])
  @@index([tenantId, relationshipId, sourceRecordId])
  @@index([tenantId, relationshipId, targetRecordId])
  @@index([tenantId, id])
  @@map("entity_relation_data")
}

model EntityData {
  id        String   @id @default(uuid())
  entityId  String
  recordId  String
  tenantId  String
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityId, recordId])
  @@index([tenantId, entityId])
  @@index([tenantId, recordId])
  @@map("entity_data")
}

model Company {
  id            String        @id @default(uuid())
  tenantId      String
  name          String
  website       String?
  industry      String?
  size          CompanySize?
  status        CompanyStatus @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  addresses     Address[]
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags          CompanyTag[]
  contacts      Contact[]
  opportunities Opportunity[]

  @@index([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, industry])
  @@map("companies")
}

model Contact {
  id            String         @id @default(uuid())
  tenantId      String
  firstName     String
  lastName      String?
  title         String?
  gender        String?
  birthDate     DateTime?
  notes         String?
  status        ContactStatus  @default(ACTIVE)
  companyId     String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  addresses     Address[]
  emails        ContactEmail[]
  phones        ContactPhone[]
  tags          ContactTag[]
  company       Company?       @relation(fields: [companyId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads         Lead[]         @relation("LeadContact")
  opportunities Opportunity[]

  @@index([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, firstName])
  @@index([tenantId, lastName])
  @@index([tenantId, firstName, lastName])
  @@index([tenantId, status])
  @@map("contacts")
}

model ContactEmail {
  id        String    @id @default(uuid())
  tenantId  String
  contactId String
  email     String
  type      EmailType @default(WORK)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, contactId])
  @@index([tenantId, email])
  @@map("contact_emails")
}

model ContactPhone {
  id        String    @id @default(uuid())
  tenantId  String
  contactId String
  phone     String
  type      PhoneType @default(MOBILE)
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, contactId])
  @@map("contact_phones")
}

model Address {
  id        String      @id @default(uuid())
  tenantId  String
  contactId String?
  companyId String?
  street    String
  city      String
  state     String
  zipCode   String
  country   String      @default("Brasil")
  type      AddressType @default(OTHER)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, contactId])
  @@index([tenantId, companyId])
  @@map("addresses")
}

model Tag {
  id            String           @id @default(uuid())
  tenantId      String
  name          String
  color         String           @default("#3B82F6")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  companies     CompanyTag[]
  contacts      ContactTag[]
  leads         LeadTag[]
  opportunities OpportunityTag[]
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, id])
  @@map("tags")
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model CompanyTag {
  companyId String
  tagId     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@map("company_tags")
}

model Lead {
  id                       String        @id @default(uuid())
  tenantId                 String
  firstName                String
  lastName                 String?
  email                    String?
  phone                    String?
  company                  String?
  source                   String?
  status                   LeadStatus    @default(NEW)
  converted                Boolean       @default(false)
  convertedAt              DateTime?
  convertedToContactId     String?
  convertedToOpportunityId String?       @unique
  deletedAt                DateTime?
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  tags                     LeadTag[]
  convertedToContact       Contact?      @relation("LeadContact", fields: [convertedToContactId], references: [id])
  convertedToOpportunity   Opportunity?  @relation("LeadConvertedToOpportunity", fields: [convertedToOpportunityId], references: [id])
  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunitiesFromLead    Opportunity[] @relation("OpportunityFromLead")

  @@index([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, firstName, lastName])
  @@index([tenantId, source])
  @@map("leads")
}

model Pipeline {
  id            String          @id @default(uuid())
  tenantId      String
  name          String
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  opportunities Opportunity[]
  stages        PipelineStage[]
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@map("pipelines")
}

model PipelineStage {
  id            String        @id @default(uuid())
  pipelineId    String
  tenantId      String
  name          String
  order         Int
  probability   Int?          @default(0)
  color         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  opportunities Opportunity[]
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

model Opportunity {
  id                String            @id @default(uuid())
  tenantId          String
  name              String
  value             Decimal           @db.Decimal(15, 2)
  currency          String            @default("BRL")
  stageId           String
  status            OpportunityStatus @default(OPEN)
  closeDate         DateTime?
  actualCloseDate   DateTime?
  probability       Int?              @default(0)
  contactId         String?
  companyId         String?
  leadId            String?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  pipelineId        String?
  convertedFromLead Lead?             @relation("LeadConvertedToOpportunity")
  company           Company?          @relation(fields: [companyId], references: [id])
  contact           Contact?          @relation(fields: [contactId], references: [id])
  lead              Lead?             @relation("OpportunityFromLead", fields: [leadId], references: [id])
  pipeline          Pipeline?         @relation(fields: [pipelineId], references: [id])
  stage             PipelineStage     @relation(fields: [stageId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags              OpportunityTag[]

  @@index([tenantId, id])
  @@index([tenantId, stageId, status])
  @@index([tenantId, contactId])
  @@index([tenantId, companyId])
  @@index([tenantId, name])
  @@index([tenantId, closeDate])
  @@map("opportunities")
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

model OpportunityTag {
  opportunityId String
  tagId         String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([opportunityId, tagId])
  @@map("opportunity_tags")
}

model Task {
  id                     String       @id @default(uuid())
  tenantId               String
  title                  String
  description            String?
  type                   TaskType     @default(OTHER)
  status                 TaskStatus   @default(PENDING)
  dueDate                DateTime?
  completedAt            DateTime?
  priority               TaskPriority @default(MEDIUM)
  assignedToId           String?
  createdById            String
  relatedEntityType      String
  relatedEntityId        String
  deletedAt              DateTime?
  lastNotificationSentAt DateTime?    @map("last_notification_sent_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  assignedTo             User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy              User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, relatedEntityType, relatedEntityId])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, dueDate])
  @@map("tasks")
}

model Note {
  id                String    @id @default(uuid())
  tenantId          String
  content           String
  type              NoteType  @default(NOTE)
  relatedEntityType String
  relatedEntityId   String
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         User      @relation(fields: [createdById], references: [id])
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, relatedEntityType, relatedEntityId])
  @@map("notes")
}

model BusinessRule {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  description    String?
  entityType     String
  condition      String
  action         String
  field          String?
  errorMessage   String?
  warningMessage String?
  severity       String   @default("error")
  active         Boolean  @default(true)
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, entityType])
  @@index([tenantId, active])
  @@map("business_rules")
}

model ImportJob {
  id                  String          @id @default(uuid())
  tenantId            String
  userId              String
  fileId              String
  entityType          String
  status              ImportJobStatus @default(PENDING)
  progress            Int             @default(0)
  totalRows           Int             @default(0)
  processedRows       Int             @default(0)
  successCount        Int             @default(0)
  errorCount          Int             @default(0)
  duplicateCount      Int             @default(0)
  result              Json?
  errorMessage        String?
  startedAt           DateTime?
  completedAt         DateTime?
  estimatedCompletion DateTime?
  retries             Int             @default(0)
  priority            JobPriority     @default(NORMAL)
  options             Json?
  mappings            Json?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("import_jobs")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum EmailType {
  WORK
  HOME
  OTHER
}

enum PhoneType {
  WORK
  HOME
  MOBILE
  OTHER
}

enum AddressType {
  BILLING
  SHIPPING
  OTHER
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONVERTED
  LOST
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum TaskType {
  CALL
  EMAIL
  MEETING
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NoteType {
  NOTE
  COMMENT
  ANNOTATION
}

enum ImportJobStatus {
  PENDING
  QUEUED
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
}
